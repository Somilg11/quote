# Postgres connection string (Neon, Supabase, RDS, local — anything Postgres).
DATABASE_URL="postgresql://user:password@host:5432/quote?sslmode=verify-full"

# Public origin of this deployment. Used for canonical URLs, OG tags, sitemap,
# share links, and the MCP endpoint shown in Settings ▸ Connections.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Outbound mail for workspace invites (Gmail app password or an SMTP provider).
GMAIL_EMAIL=""
GMAIL_APP_PASSWORD=""
RESEND_API_KEY=""

# Encrypts users' own AI provider keys at rest (AES-256-GCM). Falls back to
# NEXTAUTH_SECRET when unset. Rotating it makes saved keys unreadable, so users
# would need to paste them again.
AI_KEY_ENCRYPTION_SECRET="generate-with: openssl rand -base64 32"
